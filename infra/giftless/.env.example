# Copy to .env for local Docker testing. NEVER commit .env.
# These same values are stored as Fly secrets in prod (see scripts/set-secrets.sh).

# Cloudflare R2 credentials — from the dashboard, R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=hyperdraft-lfs

# HMAC secret used to sign JWTs that grant write access.
# Generate once with: openssl rand -base64 48
# This is the "you can push to LFS" credential. Keep it private.
GIFTLESS_JWT_SECRET=
